<!--
  shell.help-tooltip — small floating tooltip with title + summary.
  Wave 11.2 of docs/dev/composable-builder-plan.md: replaces the
  hand-rolled packages/prism-shell/src/components/help_tooltip.rs.

  Visibility gate: an empty `title` prop collapses the overlay to a
  0x0 placeholder (mirrors `shell.context-menu`, `shell.menu-dropdown`).
  The host sets both `title` and `summary` to "" when the hover queue
  is empty.
-->
<container
    if="{title}"
    tag="div"
    role="tooltip"
    data:role="help-tooltip"
    direction="column"
    gap="4"
    padding-left="10"
    padding-right="10"
    padding-top="8"
    padding-bottom="8"
    width="280"
    style:background="#f0202020"
    style:radius="6">
  <text font-size="12" style:color="#ffffff">{title}</text>
  <text if="{summary}" font-size="11" style:color="#cccccc">{summary}</text>
</container>
<container
    else
    tag="div"
    width="0"
    height="0"
    data:role="help-tooltip"
    data:visible="false"
    aria:hidden="true"/>
