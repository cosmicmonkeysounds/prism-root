# Escape the Internet

entry: doors_open

# ── Factions ────────────────────────────────────────────────────────
# The two public sides party-goers choose between, plus the hidden
# villain faction that captures people and traps them in the Internet.

FACTION Mods
  ethos: order
  rival: Chatters

FACTION Chatters
  ethos: chaos
  rival: Mods

FACTION TheAlgorithm
  ethos: control
  hidden: true

# ── Locations ───────────────────────────────────────────────────────

LOCATION Party
  label: The Party

LOCATION Internet
  label: The Internet
  prison: true

# ── Roles ───────────────────────────────────────────────────────────
# Every party-goer is cast as a Guest. Their per-person state schema
# (faction, score, captured) lives here, and the role's hooks fire for
# each Guest with `self` bound to that person.

ROLE Guest
  faction: any of FACTION
  score: 0 to 1000 = 0
  captured: bool = false
  on captured
    <set: self.score -= 25>
  on escape
    <set: self.score += 100>
    <broadcast: freedom to participant(self)>
  on scan other
    # A party-goer scans another's QR — peer ping (MagicBand model).
    <broadcast: peer_ping to participant(other)>

# ── Characters (actors) ─────────────────────────────────────────────

CHARACTER Moderator_Prime
  faction: Mods
  trusts Guest: 50 of 100
  on scan guest
    -> mod_scan

CHARACTER ModBot
  faction: TheAlgorithm
  on scan guest
    <capture: guest into Internet>

CHARACTER TheAdmin
  faction: TheAlgorithm
  on captured guest
    <broadcast: doomed to participant(guest)>
    <set: TheAdmin.captures += 1>
    <if: TheAdmin.captures >= 2>
      # Too many captures — the hidden villain faction is exposed.
      <reveal: TheAlgorithm>

CHARACTER Sentinel
  faction: TheAlgorithm
  # Reacts to a global installation cue (no subject) — an alarm.
  on lockdown
    <broadcast: lockdown_siren to faction(Mods) | faction(Chatters)>

CHARACTER Recruiter
  faction: Chatters
  on scan guest
    -> recruit

# ── Autonomous life (the clock) ─────────────────────────────────────
# The world doesn't just wait for scans. A steady tick drives ambient
# atmosphere and an escalating threat from the Algorithm.

GENERATOR FeedHum
  tier: ambient
  every 20s
  yield bark from The feed scrolls on, indifferent. | Somewhere a notification chimes. | The Algorithm is always watching. | The walls of the Internet hum.

CHARACTER Surveillance
  faction: TheAlgorithm
  # Every 30s the Algorithm's grip tightens. At threat 3 it shows itself.
  on every 30s
    <set: Surveillance.threat += 1>
    <if: Surveillance.threat >= 3>
      <broadcast: lockdown_siren to faction(Mods) | faction(Chatters)>
      <reveal: TheAlgorithm>

# ── Beats (scripted interactions) ───────────────────────────────────
# A beat plays in the binding scope of the hook that diverted to it, so
# `guest` and `self` (Moderator_Prime) are already bound here.

== mod_scan(guest)
  cast: Moderator_Prime, guest

  MODERATOR_PRIME
    <if: guest.faction == Chatters>
      A Chatter. Behave, or you're getting banned.
      <set: Moderator_Prime.trusts.guest -= 10>
    <else>
      <if: Moderator_Prime.trusts.guest > 55>
        Always good to see a face I trust. Keep it up.
      <else>
        A fellow Mod. Good to see you.
        <set: guest.score += 50>
        <set: Moderator_Prime.trusts.guest += 10>
        <respond: Verified Mod — score {guest.score}, trust {Moderator_Prime.trusts.guest}.>

# A recruiter offers a live choice: the participant decides on their phone.
== recruit(guest)
  cast: Recruiter, guest
  RECRUITER
    The Chatters could use you. What do you say?
  * Join the Chatters
    <join: guest to Chatters>
  * Stay loyal
    <set: guest.score += 10>

== doors_open
  setting: Party
  NARRATOR
    Welcome to the internet. Choose your side: Mods or Chatters.
