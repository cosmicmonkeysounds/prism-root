<!--
  shell.code-editor — code editor panel content. Wave 11.4 migration
  of code_editor.rs. The block is a deterministic retained tree
  (line-numbered gutter + per-row body + status strip); the actual
  syntax-highlight pass + caret rendering are the renderer's job.

  The binding (`state::code_editor_props`) pre-computes:
   * `lines` — `[{number, text}]` (the Rust block previously
     `split('\n')`-ed itself; now in the binding so the DSL is one
     `for=` loop).
   * `cursor-line` / `cursor-column` — 1-based positions derived
     from the byte-offset `caret`.
   * `status-label` — the "lang · Ln X, Col Y" string the status
     strip renders. Pre-formatted so the DSL stays one `{status-label}`
     interpolation instead of an inline ternary cascade.
-->
<container
    tag="section"
    direction="column"
    width="grow"
    height="grow"
    role="textbox"
    aria-multiline="true"
    aria-label="Code editor"
    data:role="code-editor">
  <container
      id="{id}::editor"
      direction="row"
      width="grow"
      height="grow"
      style:radius="4">
    <container
        id="{id}::gutter"
        direction="column"
        width="48"
        height="grow"
        padding-left="8"
        padding-right="8"
        padding-top="6"
        padding-bottom="6"
        style:background="#08000000"
        role="presentation"
        data:role="code-gutter">
      <text
          for="ln, idx in lines"
          id="{id}::gutter::{idx}"
          font-size="11"
          style:color="#80000000">{ln.number}</text>
    </container>
    <container
        id="{id}::body"
        direction="column"
        width="grow"
        height="grow"
        padding-top="6"
        padding-bottom="6"
        role="rowgroup"
        data:role="code-body">
      <container
          for="ln, idx in lines"
          id="{id}::line::{idx}"
          direction="row"
          height="18"
          padding-left="8"
          padding-right="8"
          role="row"
          data:role="code-line"
          data:line="{ln.number}"
          data:cursor="{ln.number == cursor-line && cursor-line > 0 ? 'true' : ''}">
        <text
            id="{id}::line::{idx}::text"
            font-size="12"
            style:color="#101218">{ln.text}</text>
      </container>
    </container>
  </container>
  <container
      id="{id}::status"
      direction="row"
      height="22"
      padding-left="10"
      padding-right="10"
      padding-top="4"
      padding-bottom="4"
      style:background="#06000000"
      role="status"
      data:role="code-status">
    <text
        id="{id}::status::label"
        font-size="10"
        style:color="#80000000">{status-label}</text>
  </container>
</container>
