<!--
  shell.toast — bottom-right notification card. Wave 11.2 migration of
  toast.rs.

  Layout: a fixed 320px row of [3px kind-tinted rail | title+body
  column]. Kind drives the rail colour, ARIA role, and `data-kind`
  attribute via ternary expressions over the kind discriminant
  ("success" / "warning" / "error" / fallback "info"). The body row
  is omitted entirely when the `body` prop is empty.
-->
<container
    tag="aside"
    direction="row"
    width="320"
    style:background="#f2ffffff"
    style:radius="8"
    role="{kind == 'error' ? 'alert' : 'status'}"
    data:kind="{kind}">
  <container
      width="3"
      height="grow"
      style:background="{kind == 'success' ? '#2da44e' : kind == 'warning' ? '#bf8700' : kind == 'error' ? '#cf222e' : '#0969da'}"/>
  <container
      direction="column"
      width="grow"
      gap="4"
      padding-left="12"
      padding-right="12"
      padding-top="10"
      padding-bottom="10">
    <text font-size="13" style:color="#cc000000">{title}</text>
    <text if="{body}" font-size="12" style:color="#99000000">{body}</text>
  </container>
</container>
