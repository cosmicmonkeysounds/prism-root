<!--
  shell.command-palette — Ctrl+Shift+P fuzzy-find palette overlay.
  Wave 11.3 (Tier-2) migration of command_palette.rs.

  Closed → 0×0 hidden overlay so visibility is host state. Open →
  480px rounded card with a query `<input>` row and a result list.
  Selection state lives on the host (`AppState::command_palette_*`);
  the DSL just paints the visual structure and uses for-loop `idx`
  to drive the selected-row tint.
-->
<container
    if="{!open}"
    tag="div"
    width="0"
    height="0"
    data:role="command-palette"
    data:visible="false"
    aria:hidden="true"/>
<container
    else
    id="{id}"
    tag="div"
    direction="column"
    gap="8"
    padding-left="12"
    padding-right="12"
    padding-top="12"
    padding-bottom="12"
    width="480"
    style:radius="8"
    style:background="#ffffff"
    role="dialog"
    aria-label="Command palette"
    data:role="command-palette">
  <input
      id="{id}::input"
      value="{query}"
      placeholder="{placeholder}"
      focused="true"
      caret-byte="{caret}"
      selection="{selection}"
      width="grow"
      height="36"
      font-size="13"/>
  <container
      id="{id}::results"
      direction="column"
      width="grow">
    <container
        for="item, idx in results"
        id="{id}::row::{idx}"
        tag="div"
        direction="row"
        gap="12"
        padding-left="8"
        padding-right="8"
        padding-top="6"
        padding-bottom="6"
        width="grow"
        height="32"
        style:radius="4"
        style:background="{idx == selected-index ? '#190060c0' : ''}"
        style:background:hovered="{idx == selected-index ? '' : '#0f000000'}"
        role="option"
        aria:selected="{idx == selected-index ? 'true' : ''}">
      <text font-size="13" style:color="#000000">{item.label}</text>
      <text if="{item.shortcut}" font-size="11" style:color="#88000000">{item.shortcut}</text>
    </container>
  </container>
</container>
