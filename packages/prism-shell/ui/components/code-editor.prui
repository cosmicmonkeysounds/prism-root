<!--
  shell.code-editor — code editor panel. Real editor on top of
  prism-ui-runtime's `TextEditor`: a tab strip across the top, a
  per-line numbered gutter on the left, and one editable multi-line
  `<input>` for the body that paints the whole buffer (caret + selection
  + bracket-match + IME preedit all ride on the shaped glyph run).

  Bindings:
   * `tabs` — `[{index, title, dirty, active, path}]` from
     `CanvasSlot::editor_tab_strip`.
   * `active-tab` — display index of the currently active tab.
   * `source` / `caret-byte` / `selection` / `underline` /
     `bracket-match` / `scroll-x` / `scroll-y` / `highlight-current-line`
     — the active tab's editor state.
   * `lines` — gutter row entries.
   * `language` / `cursor-line` / `cursor-column` / `status-label` —
     status strip.

  Routing: pointer-down on a `data-role="editor-tab"` switches the
  active tab; `data-role="editor-tab-close"` closes one. `data-role=
  "editor-tab-new"` opens a fresh Untitled tab. The body's
  `data-role="code-editor-body"` continues to drive caret positioning.
-->
<container
    tag="section"
    direction="column"
    width="grow"
    height="grow"
    role="textbox"
    aria-multiline="true"
    aria-label="Code editor"
    data:role="code-editor">
  <container
      id="{id}::tabs"
      direction="row"
      width="grow"
      height="28"
      padding-left="4"
      padding-right="4"
      padding-top="2"
      padding-bottom="0"
      gap="2"
      style:background="#04000000"
      role="tablist"
      data:role="editor-tab-strip">
    <container
        for="t, idx in tabs"
        id="{id}::tab::{idx}"
        direction="row"
        height="24"
        padding-left="10"
        padding-right="6"
        padding-top="3"
        padding-bottom="3"
        gap="6"
        role="tab"
        data:role="editor-tab"
        data:tab-index="{t.index}"
        data:active="{t.active ? 'true' : ''}"
        data:dirty="{t.dirty ? 'true' : ''}"
        style:background="{t.active ? '#ffffff' : '#08000000'}"
        style:radius="3">
      <text
          id="{id}::tab::{idx}::title"
          font-size="11"
          style:color="{t.active ? '#101218' : '#70000000'}">{t.dirty ? '● ' : ''}{t.title}</text>
      <container
          id="{id}::tab::{idx}::close"
          width="14"
          height="14"
          padding-left="3"
          padding-right="3"
          padding-top="0"
          padding-bottom="0"
          role="button"
          aria-label="Close tab"
          data:role="editor-tab-close"
          data:tab-index="{t.index}"
          style:radius="2">
        <text
            id="{id}::tab::{idx}::close::glyph"
            font-size="10"
            style:color="#60000000">×</text>
      </container>
    </container>
    <container
        id="{id}::tab::new"
        width="20"
        height="24"
        padding-left="6"
        padding-right="6"
        padding-top="3"
        padding-bottom="3"
        role="button"
        aria-label="New tab"
        data:role="editor-tab-new"
        style:radius="3">
      <text font-size="13" style:color="#60000000">+</text>
    </container>
  </container>
  <container
      id="{id}::editor"
      direction="row"
      width="grow"
      height="grow"
      style:radius="4">
    <container
        id="{id}::gutter"
        direction="column"
        width="48"
        height="grow"
        padding-left="8"
        padding-right="8"
        padding-top="6"
        padding-bottom="6"
        style:background="#08000000"
        role="presentation"
        data:role="code-gutter">
      <text
          for="ln, idx in lines"
          id="{id}::gutter::{idx}"
          font-size="11"
          style:color="#80000000">{ln.number}</text>
    </container>
    <input
        id="{id}::body"
        value="{source}"
        placeholder=""
        width="grow"
        height="grow"
        multiline="true"
        caret-byte="{caret-byte}"
        selection="{selection}"
        underline="{underline}"
        bracket-match="{bracket-match}"
        highlight-current-line="{highlight-current-line}"
        syntax-language="{language}"
        scroll-x="{scroll-x}"
        scroll-y="{scroll-y}"
        font-size="13"
        style:color="#101218"
        data:role="code-editor-body"
        data:cursor-line="{cursor-line}"
        data:cursor-column="{cursor-column}"/>
  </container>
  <container
      id="{id}::status"
      direction="row"
      height="22"
      padding-left="10"
      padding-right="10"
      padding-top="4"
      padding-bottom="4"
      style:background="#06000000"
      role="status"
      data:role="code-status">
    <text
        id="{id}::status::label"
        font-size="10"
        style:color="#80000000">{status-label}</text>
  </container>
</container>
