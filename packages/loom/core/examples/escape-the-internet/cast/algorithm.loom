# Cast — The Algorithm (hidden faction)
#
# The villain. It never sweeps the room — it reacts to individuals. Every
# plain scanner prop is now one line: an `AlgoScanner(beat)` (faction badge +
# the scan→beat router, from `cast/kit.loom`). The members that carry real
# behaviour of their own take only the `Algo` badge and write their hooks
# inline. `Sysadmin` and `Firewall_Terminal` go further still — they *own*
# their beat, authored right beside the scan that reaches it (`-> self.beat`).

# ── Members with behaviour of their own (badge only) ─────────────────
CHARACTER ModBot is Algo
  on scan guest
    <capture: guest into Internet>

CHARACTER TheAdmin is Algo
  captures: 0 to 100 = 0
  on captured guest
    <broadcast: doomed to participant(guest)>
    <set: self.captures += 1>
    <if: self.captures >= 2>
      # Too many disappearances — the hidden faction is exposed.
      <reveal: TheAlgorithm>
  on revealed
    <broadcast: unmasked to faction(Mods) | faction(Chatters)>

CHARACTER Sentinel is Algo
  # Targeted, never ambient: the Sentinel only speaks to the one guest who
  # just crossed into a cell, addressing them by their pass.
  on enters Internet captive
    <broadcast: lockdown to participant(captive)>
  on enters Servers captive
    <broadcast: deep_lockdown to participant(captive)>

CHARACTER Surveillance is Algo
  # The autonomous clock the host ticks — pure indifferent bookkeeping.
  on every 60s
    <set: TheAlgorithm.sweeps += 1>

# ── Members that OWN their beat (scan routes to `self.<beat>`) ────────
# The Sysadmin works a captive for names — its scene lives right here.
CHARACTER Sysadmin is Algo
  on scan guest
    -> self.interrogation
  beat interrogation(guest)
    SELF
      <if: guest.captured>
        Designation {guest.name}. Heat on file: {guest.heat}. Talk.
        Tell me who showed you the static and maybe your sentence shortens.
      <else>
        Not in a cell yet? Then we have nothing to discuss. Move along.
    <if: guest.captured>
      * Name the Glitchers
        <set: guest.heat -= 10>
        <set: guest.karma -= 15>
        <respond: Cooperation logged. Pathetic.>
      * Say nothing
        <set: guest.karma += 20>
        <broadcast: stayed_silent to participant(guest)>
      + Lie through your teeth
        <set: guest.heat += 10>

# The firewall: a wall to the free, a seam to the trapped.
CHARACTER Firewall_Terminal is Algo
  on scan guest
    -> self.firewall
  beat firewall(guest)
    SELF
      <if: guest.captured>
        A seam in the wall, right where the Oracle said it would be. Push it?
      <else>
        The firewall hums. Touching it from the outside only gets you noticed.
    <if: guest.captured>
      * Force the breach — RUN
        <escape: guest>
      + Back away from the wall
        <set: guest.karma += 2>
    <else>
      <set: guest.heat += 15>
      -> lockdown

# ── Plain scanner props — one line each ──────────────────────────────
CHARACTER Crawler          is AlgoScanner(crawler_report)
CHARACTER Captcha          is AlgoScanner(captcha_gate)
CHARACTER Terminal         is AlgoScanner(the_terminal)
CHARACTER Cookie_Banner    is AlgoScanner(cookie_consent)
CHARACTER Ad_Popup         is AlgoScanner(the_ad)
CHARACTER Download_Station is AlgoScanner(download)
CHARACTER Paywall          is AlgoScanner(paywall)
