<!--
  shell.explorer — left rail file/object explorer. Hosts a column of
  `shell.inspector-row` entries via the `nodes` JSON prop. Wave 11.2
  migration of explorer.rs.

  Each row in the `nodes` array carries `{ label, kind, depth, ... }`;
  the `for` loop spreads typed fields onto the dispatched block
  through the resolver's interpolation pass.
-->
<container
    tag="aside"
    direction="column"
    padding-left="4"
    padding-right="4"
    padding-top="4"
    padding-bottom="4"
    width="grow"
    height="grow"
    aria-label="Explorer"
    data:role="explorer">
  <shell.inspector-row
      for="item in nodes"
      id="{item.node-id}"
      label="{item.label}"
      kind="{item.kind}"
      depth="{item.depth}"/>
</container>
