// Smoke-test fixture covering every line class + inline atom the
// VSCode extension highlights. Open this in the Extension Development
// Host (F5) to verify a grammar regen visually.

# harbor_greeting "The Harbor" :conversation :immersive
  .actors wren, hale
  .tags chapter-1
  .cohort initiate, singers

'''
Opening scene at the dock. Wren is the first cast slot the player
ever meets; the bell motif comes back in act 3.
'''

// ── cast / cue / location / cohort declarations ──────────────────────

cast WREN
  .label "Wren the Fisher"
  .voice female_mezzo
  .open
  .improv .latitude(0.5)

cast BELLKEEPER
  .label "The Bellkeeper"

cue bell_strike_loud
  .target sound_console
  .preset bell_main
  .level 0.9
  .fade 250ms

location BELL_TOWER
  .label "The Bell Tower"
  .capacity 12
  .threshold "RFID gate at the foot of the stairs"
  .connects HARBOR_OFFICE

cohort singers
  .label "The Singers"
  .capacity 6
  .secret "Members can hear the bell when nobody else can."

// ── bindings & s-expressions ─────────────────────────────────────────

(define met_wren = false)
(list factions: rebels, loyalists, neutrals)

let trusted = $wren_trust > 30 and $met_wren

// ── sections + dialogue + the three sigils ───────────────────────────

-- start  .hub  if not $tutorial_done

WREN { worried, voice: low }
  The bell went silent three days ago.
  Maren's gone.

  * I'll help. -> investigate
      WREN { surprised }
        You will?<pause:300>
      ~ var $met_wren := true
      -> investigate

  * Not my problem. -> leave  if not $trusted

-- investigate

after $trusted
  WREN { warm }
    [[object:maren|Maren]] taught me to
    listen to <speed:0.7>the water</> very carefully.
    <sfx:bell+camera:shake>
    <?$wren_trust > 70><sfx:heartbeat>

otherwise
  WREN
    She just... stopped.

// ── live-immersive: participant lifecycle + broadcast ────────────────

when participant joins
  enroll $PARTICIPANT into initiate
  -> orientation as $PARTICIPANT

when participant enters @BELL_TOWER
  ~ cue bell_strike_loud
  broadcast :participant($PARTICIPANT) but :cohort(initiate)
    NARRATOR { whispering }
      You hear it differently.

// ── character archetype block ────────────────────────────────────────

knowledge
  met_player: bool = false
  rumor_count: int = 0
  factions_known: list<string> = nil

goal investigate_bell
  priority       = 0.9
  active_when    = $met_wren and not played(found_clue)
  completes_when = chose(give_evidence) or visits(harbor_office) >= 3
  drives         generator wander_with_purpose
  on_complete    fire bell_solved
  on_fail        modify $reputation -= 5

disposition $PLAYER
  trust = -1..1, init 0.0
  fear  = 0..1, init 0.0, mirror $PLAYER.disposition.dread
  reacts $PLAYER.disposition.trust > 0.8 -> "ally"

on $wren_trust passes 50
  ~ fire trust_threshold_hit

// ── stats archetype block ────────────────────────────────────────────

attribute strength = 10, range 0..20
axis combat
  mode use_tracking
  on use @combat.swing_sword
  on advance fire combat_advanced; modify $xp += 5
  curve $combat * $combat * 100

pool stamina
  max   = 100
  min   = 0
  regen 5 / 1s when not in_combat
  init  = 100

stat damage = $strength + $weapon.damage
stat dodge_chance
  lookup $agility
  table {0: 0.05, 10: 0.15, 20: 0.30}
  interpolate linear

// ── reactivity: generator + scene + compose ──────────────────────────

generator wander_with_purpose
  .tier   ambient
  .priority 0.4
  .budget_ms 8
  loop forever
    wait random(30s, 90s)
    when at_a_landmark
      yield bark from @observations

scene first_meeting |player, npc|
  greeting
    wait until $player.distance($npc) < 2
    NPC
      Have we met?
    -> response

  response
    match $player.disposition.trust
      "high"
        NPC
          You look familiar.
      _
        NPC
          ...you're a stranger here.
        return false

compose ship_name
  pattern $size
    1..3  : "skiff"
    4..7  : "sloop"
    8..15 : "schooner"
    _     : "frigate"

// ── faction archetype block ──────────────────────────────────────────

faction rebels
  .label "The Tideturners"
  .color "#3b82f6"
  members
    @wren, @hale visibility: public
    cohort singers visibility: cohort(initiate)
  state
    morale = 0..100, init 50
    cohesion = 0..1, init 0.7
  stance
    @loyalists = hostile asymmetric
    default = neutral

when faction emerges from template @grassroots
  ~ fire new_faction_formed
  NARRATOR
    The water carries whispers of a new banner.

// ── inline assigns, range closers, ledger predicates ─────────────────

-- finale

WREN { final }
  And then<beat:1s>... <speed:0.5>silence<$wren_trust := 100>.</>
  If you played(intro) and visits(bell_tower) >= 3,
  the bell is yours.

-> ${if $trusted then "good_end" else "ambiguous_end"} as $PARTICIPANT

<- finale_return
