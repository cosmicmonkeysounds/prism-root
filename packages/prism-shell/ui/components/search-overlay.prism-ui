<!--
  shell.search-overlay — Ctrl+F document-search overlay. Sister to
  `shell.command-palette` in shape: a modal card with a query
  `<input>` row and a result list. The query buffer is a full
  `TextEditor` (single-line) routed through the shared text-input
  dispatch, so the input gets caret nav, selection, Ctrl+A,
  Ctrl+C/X/V, and IME for free.

  Closed → 0×0 hidden overlay so visibility is host state. Open →
  420px rounded card. Selection state lives on the host
  (`AppState::search.*`); the DSL just paints the visual structure
  and uses for-loop `idx` to drive the selected-row tint.
-->
<container
    if="{!open}"
    tag="div"
    width="0"
    height="0"
    data:role="search-overlay"
    data:visible="false"
    aria:hidden="true"/>
<container
    else
    id="{id}"
    tag="div"
    direction="column"
    gap="8"
    padding-left="12"
    padding-right="12"
    padding-top="12"
    padding-bottom="12"
    width="420"
    style:radius="8"
    style:background="#ffffff"
    role="dialog"
    aria-label="Find in document"
    data:role="search-overlay">
  <input
      id="{id}::input"
      value="{query}"
      placeholder="Find…"
      focused="true"
      caret-byte="{caret}"
      selection="{selection}"
      width="grow"
      height="36"
      font-size="13"/>
  <container
      id="{id}::results"
      direction="column"
      width="grow">
    <container
        for="hit, idx in results"
        id="{id}::row::{idx}"
        tag="div"
        direction="row"
        gap="12"
        padding-left="8"
        padding-right="8"
        padding-top="6"
        padding-bottom="6"
        width="grow"
        height="36"
        style:radius="4"
        style:background="{idx == selected-index ? '#190060c0' : ''}"
        style:background:hovered="{idx == selected-index ? '' : '#0f000000'}"
        role="option"
        aria:selected="{idx == selected-index ? 'true' : ''}">
      <text font-size="13" style:color="#000000">{hit.label}</text>
      <text font-size="11" style:color="#88000000">{hit.snippet}</text>
    </container>
  </container>
</container>
