# harbor_greeting "The Harbor"
  .actors wren, hale
  .tags chapter-1

'''
Opening scene at the dock.
'''

cast WREN
  .label "Wren the Fisher"
  .voice female_mezzo

-- start

WREN { worried }
  The bell went silent three days ago.
  Maren's gone.

  * I'll help. -> investigate
      WREN { surprised }
        You will?<pause:300>
      ~ var $met_wren := true
      -> investigate

  * Not my problem. -> leave  if not $trusted

-- investigate

after $trusted
  WREN { warm }
    [[object:maren|Maren]] taught me to
    listen to <speed:0.7>the water</>.

otherwise
  WREN
    She just... stopped.
