{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "paths": {
      "@loom/core/parser": ["../core/src/parser/index.ts"],
      "@loom/core/lsp": ["../core/src/lsp/index.ts"],
      "@loom/core/sim": ["../core/src/runtime/sim/index.ts"],
      "@loom/core/chat": ["../core/server/chat.ts"],
      "@loom/core/views": ["../core/server/views.ts"],
      "@loom/core": ["../core/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
