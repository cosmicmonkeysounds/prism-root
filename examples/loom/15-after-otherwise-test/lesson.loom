# after_otherwise_demo

cast WREN
  .label "Wren"

let trusted = $trust > 50

-- setup

~ var $trust := 70
~ var $morning := true

-- door

after $trusted
  WREN { warm }
    Come in. Stay a while.
otherwise
  WREN { wary }
    State your business.

after $morning
  > Tea is on the stove.
otherwise
  > The kettle is cold.

WREN
  Either way -- you're here.
