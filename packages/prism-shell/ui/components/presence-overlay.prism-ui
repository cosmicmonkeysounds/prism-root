<!--
  shell.presence-overlay — IDE Phase D collaborative presence facepile.

  A window-relative overlay sibling (like the pickers): one chip per
  remote peer, fed from `state.devtools.presence` (the
  `PresenceManager` ingest the idle tick drains). Each chip shows the
  peer's colour swatch + display name + the node id they currently
  have selected, so "who's here and where" is live without leaving
  the canvas.

  Closed → 0×0 hidden sibling so visibility is host state (the
  `visible` prop is false when no remote peers are present). Open →
  a compact column anchored by the host's overlay z-layer.

  Pixel-accurate peer cursors are deliberately out of scope: the
  upstream `PresenceState` carries an `object_id` anchor, not a
  surface coordinate, so this paints the collaborative *anchor* (the
  selected node) rather than a free-floating caret. A presence
  coordinate channel would light a true cursor up with no shape
  change here.
-->
<container
    if="{!visible}"
    tag="div"
    width="0"
    height="0"
    data:role="presence-overlay"
    data:visible="false"
    aria:hidden="true"/>
<container
    else
    id="{id}"
    tag="div"
    direction="column"
    gap="4"
    padding-left="8"
    padding-right="8"
    padding-top="8"
    padding-bottom="8"
    style:radius="8"
    style:background="#ffffffe6"
    role="status"
    aria-label="Collaborators"
    data:role="presence-overlay">
  <container
      for="peer, idx in peers"
      id="{id}::peer::{idx}"
      tag="div"
      direction="row"
      gap="8"
      padding-left="6"
      padding-right="6"
      padding-top="4"
      padding-bottom="4"
      width="grow"
      height="24"
      style:radius="4"
      role="listitem"
      data:role="presence-peer"
      data-peer-id="{peer.peer-id}">
    <container
        width="10"
        height="10"
        style:radius="5"
        style:background="{peer.color}"/>
    <text font-size="12" style:color="#000000">{peer.display-name}</text>
    <text font-size="11" style:color="#66000000">{peer.selection}</text>
  </container>
</container>
