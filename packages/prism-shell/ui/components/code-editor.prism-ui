<!--
  shell.code-editor — code editor panel. A real editor on top of
  prism-ui-runtime's `TextEditor`: a per-line numbered gutter on the
  left and one editable multi-line `<input>` on the right that paints
  the whole buffer (caret + selection ride on the shaped glyph run).

  The binding (`CanvasSlot::code_editor_props`) feeds:
   * `source` — the whole buffer (one big string, `\n`-separated).
   * `caret-byte` — byte offset of the caret. The runtime input
     parser converts this to a per-glyph position in cosmic-text.
   * `selection` — optional `"start,end"` byte range. Omitted when
     no selection is active so the resting render carries no noise.
   * `lines` — one row per source line, `{number}`-only. Drives the
     gutter via a `for=` loop; the body needs no per-line authoring.
   * `cursor-line` / `cursor-column` / `status-label` — for the
     bottom strip.

  Click-to-focus + keyboard route through the shell's
  `field_focus` / code-buffer paths once the click router learns to
  resolve a `data-role="code-editor-body"` hit to a byte offset.
  Until then, programmatic edits (Luau host, paste, undo via the
  global Edit menu) drive the buffer; the editor still renders the
  caret + selection from the current state.
-->
<container
    tag="section"
    direction="column"
    width="grow"
    height="grow"
    role="textbox"
    aria-multiline="true"
    aria-label="Code editor"
    data:role="code-editor">
  <container
      id="{id}::editor"
      direction="row"
      width="grow"
      height="grow"
      style:radius="4">
    <container
        id="{id}::gutter"
        direction="column"
        width="48"
        height="grow"
        padding-left="8"
        padding-right="8"
        padding-top="6"
        padding-bottom="6"
        style:background="#08000000"
        role="presentation"
        data:role="code-gutter">
      <text
          for="ln, idx in lines"
          id="{id}::gutter::{idx}"
          font-size="11"
          style:color="#80000000">{ln.number}</text>
    </container>
    <input
        id="{id}::body"
        value="{source}"
        placeholder=""
        width="grow"
        height="grow"
        multiline="true"
        caret-byte="{caret-byte}"
        selection="{selection}"
        underline="{underline}"
        syntax-language="{language}"
        scroll-x="{scroll-x}"
        scroll-y="{scroll-y}"
        font-size="13"
        style:color="#101218"
        data:role="code-editor-body"
        data:cursor-line="{cursor-line}"
        data:cursor-column="{cursor-column}"/>
  </container>
  <container
      id="{id}::status"
      direction="row"
      height="22"
      padding-left="10"
      padding-right="10"
      padding-top="4"
      padding-bottom="4"
      style:background="#06000000"
      role="status"
      data:role="code-status">
    <text
        id="{id}::status::label"
        font-size="10"
        style:color="#80000000">{status-label}</text>
  </container>
</container>
