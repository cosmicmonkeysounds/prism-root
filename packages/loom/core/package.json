{
  "name": "@loom/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Native TypeScript port of the Loom engine (parser + ecosystem-sim runtime) plus the SSE/REST event server for live LAN events. No WASM, no Prism.",
  "exports": {
    ".": "./src/index.ts",
    "./parser": "./src/parser/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./sim": "./src/runtime/sim/index.ts",
    "./lsp": "./src/lsp/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx server/migrate.ts",
    "serve": "tsx server/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "better-auth": "^1.6.23",
    "pg": "^8.22.0"
  }
}
