{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["[[", "]]"],
    ["${", "}"],
    ["$(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "[[", "close": "]]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'''", "close": "'''", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["[[", "]]"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^(\\s*)(--|##|cast |cue |location |cohort |faction |generator |scene |compose |members|state|stance|knowledge|disposition|broadcast |when |at |after |otherwise|each visit|loop|match |\\*|\\+).*$",
    "decreaseIndentPattern": "^(\\s*)(otherwise|finally)\\s*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(--|##|generator |scene |compose |cast |cue |location |cohort |faction )\\b",
      "end": "^\\s*(--|##)\\b"
    }
  }
}
