<!--
  shell.nav-button — 48×48 activity-bar icon. Wave 11.2 migration of
  nav_button.rs (collapsed to a single container via Wave 11.2
  ternary substrate; the two-branch if/else form is the v0 fallback
  before the substrate landed).

  Layout: a 48×48 row of [3px accent rail, 45px centred glyph body].
  Selected paints the rail + tinted background and sets aria-pressed;
  resting paints a translucent hover tint instead. The `nav-id` flows
  to `data-target-id` so the existing `handle_nav_button_click` route
  routes off it.
-->
<container
    tag="button"
    direction="row"
    width="48"
    height="48"
    style:background="{selected ? '#260060c0' : ''}"
    style:background:hovered="{selected ? '' : '#1f000000'}"
    data:role="nav-button"
    data:target-id="{nav-id}"
    aria:pressed="{selected ? 'true' : ''}">
  <container
      width="3"
      height="grow"
      style:background="{selected ? '#0060c0' : ''}"/>
  <container
      width="grow"
      height="grow"
      padding-left="11"
      padding-right="11"
      padding-top="14"
      padding-bottom="14">
    <image src="{icon}" width="20" height="20"/>
  </container>
</container>
